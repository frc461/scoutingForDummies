<script>
  setTimeout(() => Turbo.visit(window.location.href, { action: "replace" }), 150000);
</script>

<h1><%= @event[:name] %></h1>

<div class="row">
  <div class="col-md-6">
    <h2>Matches</h2>
    <ul>
      <% @matches.each do |match| %>
        <li><a href="/matches/<%= match[:code] %>"><%= match[:code] %></a> | <%= match[:time].strftime("%l:%M %p")%></li>
      <% end %>
    </ul>
  </div>
  <div class="col-md-6">
    <h2>Teams in Attendance</h2>
      <% @teams.each do |team| %>
        <div class="card mb-3">
          <div class="card-header"><h3><a href="/teams/<%= team[:number] %>"><%= team[:number] %> - <%= team[:name] %></a></h3></div>
          <div class="card-body">
            <% @notes.where(team_number: team[:number]).each do |note| %>
              <div class="mb-2"><%= note[:content] %></div>
            <% end %>
          </div>
        </div>
      <% end %>
  </div>
</div>
