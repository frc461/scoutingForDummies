<script>
  setTimeout(() => Turbo.visit(window.location.href, { action: "replace" }), 150000);
</script>

<h1><%= @match[:code] %></h1>

 <div class="card mb-3">
        <div class="card-header"><h3><%= @match[:code].split('_').last %> / <%= @match[:predicted_time].strftime("%l:%M %p") %></h3></div>
        <div class="card-body">
          <div class="row text-center align-items-center mb-1">
            <div class="col-6">
              <h4>Red Alliance</h4>
              <div class="row" style="background-color: #ff000016">
                <% @plays.where(alliance: 'red').each do |play| %>
                  <div class="col <%= "fw-bolder" if play[:team_number].to_s == ENV['TEAM'] %>"><%= play[:team_number] %></div>
                <% end %>
              </div>
            </div>
            <div class="col-6">
              <h4>Blue Alliance</h4>
              <div class="row" style="background-color: #0000ff16">
                <% @plays.where(alliance: 'blue').each do |play| %>
                  <div class="col <%= "fw-bolder" if play[:team_number].to_s == ENV['TEAM'] %>"><%= play[:team_number] %></div>
                <% end %>
              </div>
            </div>
          </div>
    
         <div class="row text-center bg-dark text-light align-items-center">
            <div class="col-5">
              <%= @match_prediction['red_score']%>
            </div>
            <div class="col-2">
              <%= @match_prediction['winner'] %> 
              <div>predicted to win</div>
            </div>
            <div class="col-5">
              <%= @match_prediction['blue_score']%>
            </div>
          </div>
        </div>
      </div>
<div class="row">
  
  <div class="col-md-6">
    <h2>Predicted Time</h2>
    <p><%= @match[:predicted_time].strftime("%l:%M %p, %e %b %y") %></p>
    <h2>Predicted Results</h2>
    <pre><%= JSON.pretty_generate(JSON.parse(@match[:prediction])) %></pre>
  </div>
  <div class="col-md-6">
    <h2>Status</h2>
    <p><%= @match[:status] %></p>
    <h2>Time</h2>
    <p><%= @match[:time].strftime("%l:%M %p, %e %b %y") %></p>
    <h2>Results</h2>
    <pre><%= JSON.pretty_generate(JSON.parse(@match[:real_results])) %></pre>
  </div>
</div>

<table class="table">
  <thead>
    <tr>
      <th>Team Number</th>
      <th>Team Name</th>
      <th>Alliance</th>
      <th>EPA</th>
    </tr>
  </thead>
  <tbody>
    <% @plays.each do |play| %>
      <tr>
        <td><a href="/teams/<%= play[:team_number] %>"><%= play[:team_number] %></a></td>
        <td><%= play[:name] %></td>
        <td><%= play[:alliance] %></td>
        <td><pre><%= JSON.pretty_generate(JSON.parse(play[:epa])) %></pre></td>
      </tr>
    <% end %>
  </tbody>